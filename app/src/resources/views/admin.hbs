<script>
    google.maps.event.addDomListener(window, 'load', function () {
        var options = {
            zoom: 7,
            center: new google.maps.LatLng(9.826869295841263, 105.64292080544745),
            mapTypeId: google.maps.MapTypeId.ROADMAP
        };

        var map = new google.maps.Map(document.getElementById('map'), options);

        function addMarker(data) {
            var vido = parseFloat(data.vi_do);
            var kinhdo = parseFloat(data.kinh_do);
            if (isNaN(vido) || isNaN(kinhdo)) {
                console.error("Tọa độ không hợp lệ cho nhà hàng:", data.ten);
                return;
            }

            // Tạo vị trí của điểm đánh dấu
            var position = new google.maps.LatLng(vido, kinhdo);

            // Tạo điểm đánh dấu và thêm nó lên bản đồ
            var marker = new google.maps.Marker({
                position: position,
                map: map,
                title: data.ten
            });
        }

        function loadMarkersFromAPI() {
            var url = 'http://localhost:3001/json-nha-hang';

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    console.log("Dữ liệu từ API:", data);


                    data.forEach(item => {
                        addMarker(item);
                    });
                })
                .catch(error => console.error('Lỗi khi lấy dữ liệu từ API:', error));
        }

        loadMarkersFromAPI();
    });
</script>