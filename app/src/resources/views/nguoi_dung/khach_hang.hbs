    </div>
    <div class="mobile-menu-overlay"></div>

    <div class="main-container">
        <div class="pd-ltr-20 xs-pd-20-10">
            <div class="min-height-200px">
                <div class="page-header">
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="title">
                                <h4>Khách hàng</h4>
                            </div>
                            <nav aria-label="breadcrumb" role="navigation">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/admin">Trang chủ </a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        Khách hàng
                                    </li>
                                </ol>
                            </nav>
                        </div>

                    </div>
                </div>

                <!-- Simple Datatable start -->
                <div class="card-box mb-30">
                    <div class="pb-20">
                        <table class="table   data-table-export nowrap">
                            <thead>
                                <tr>
                                    <th class="table-plus datatable-nosort">Avatar</th>
                                    <th>Người dùng</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                    <th>Địa chỉ</th>
                                    <th>Trạng thái</th>
                                    <th class="datatable-nosort">Tuỳ chọn</th>

                                </tr>
                            </thead>
                            <tbody>
                                {{#each tat_ca_khach_hang}}

                                <tr>
                                    <td class="table-plus">
                                        <img src="images/avatar/{{this.avatar}}" width="70" height="70" alt="" />
                                    </td>
                                    <td>
                                        <h5 class="font-16">{{this.username}}</h5>
                                        {{this.fullname}}
                                    </td>

                                    <td>{{this.phone}}</td>
                                    <td>{{this.email}}</td>

                                    <td>{{this.address}}</td>
                                    <td>{{this.status}}</td>
                                    <td>
                                        <div class="dropdown">
                                            <a class="btn btn-link font-24 p-0 line-height-1 no-arrow dropdown-toggle"
                                                href="#" role="button" data-toggle="dropdown">
                                                <i class="dw dw-more"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-right dropdown-menu-icon-list">
                                                <a class="dropdown-item" href="/ho-so/{{this._id}}"><i
                                                        class="dw dw-eye"></i> Xem chi
                                                    tiết</a>
                                                <a class="dropdown-item btn-block" data-toggle="modal"
                                                    data-target="#modal-update-{{this._id}}" type="button"><i
                                                        class="dw dw-edit2"></i> Cập
                                                    nhật</a>
                                                <a class="dropdown-item btn-block" href="#" data-toggle="modal"
                                                    data-target="#delete-modal-{{this._id}}" type="button">
                                                    <i class="dw dw-delete-3"></i>Xoá

                                                </a>
                                            </div>
                                        </div>
                                    </td>

                                    {{!-- modal delete --}}
                                    <div class="modal fade" id="delete-modal-{{this._id}}" tabindex="-1" role="dialog"
                                        aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-sm modal-dialog-centered">
                                            <div class="modal-content bg-danger text-white">
                                                <div class="modal-body text-center">
                                                    <h3 class="text-white mb-15">
                                                        <i class="fa fa-exclamation-triangle"></i> Cảnh Báo
                                                    </h3>
                                                    <p>
                                                        Dữ liệu của khách hàng: <span
                                                            class="text-blue fw-bold">{{this.fullname}}</span> sẽ bị xoá
                                                        vĩnh viễn và
                                                        không thể khôi phục được nếu bạn tiếp tục xác nhận.
                                                        Cập nhật thông tin khách hàng!
                                                    </p>
                                                    <form method="POST"
                                                        action="/nguoi-dung/{{this._id}}?_method=DELETE">
                                                        <button class="btn btn-light">
                                                            <i class="icon-copy ion-checkmark"></i>
                                                        </button>
                                                    </form>
                                                    <button class="btn btn-light" type="button" data-dismiss="modal">
                                                        <i class="icon-copy ion-close-round"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    {{!-- modal delete --}}
                                </tr>

                                {{!-- modal update --}}
                                <div class="modal fade bs-example-modal-lg" id="modal-update-{{this._id}}" tabindex="-1"
                                    role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h4 class="modal-title" id="myLargeModalLabel">
                                                    Large modal
                                                </h4>
                                                <button type="button" class="close" data-dismiss="modal"
                                                    aria-hidden="true">
                                                    ×
                                                </button>
                                            </div>
                                            <form method="POST" action="/nguoi-dung/{{this._id}}?_method=PUT">
                                                <div class="modal-body">

                                                    <div class="form-group row">
                                                        <label class="col-sm-12 col-md-2 col-form-label">Họ và
                                                            tên</label>
                                                        <div class="col-sm-12 col-md-10">
                                                            <input name="fullname" value="{{this.fullname}}"
                                                                class="form-control" type="text" placeholder="">
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label class="col-sm-12 col-md-2 col-form-label">Email</label>
                                                        <div class="col-sm-12 col-md-10">
                                                            <input name="email" value="{{this.email}}"
                                                                class="form-control" type="email" placeholder="">
                                                        </div>
                                                    </div>

                                                    <div class="form-group row">
                                                        <label class="col-sm-12 col-md-2 col-form-label">Số điện thoại
                                                        </label>
                                                        <div class="col-sm-12 col-md-10">
                                                            <input name="phone" value="{{this.phone}}"
                                                                class="form-control" type="tel" placeholder="">
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label class="col-sm-12 col-md-2 col-form-label">Địa chỉ</label>
                                                        <div class="col-sm-12 col-md-10">
                                                            <select name="address" class="custom-select col-12">
                                                                <option>{{this.address}}</option>
                                                                {{#each ../xa_kien_giang}}
                                                                <option>{{this.path_with_type}}</option>
                                                                {{/each}}
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label class="col-sm-12 col-md-2 col-form-label">Trạng
                                                            thái</label>
                                                        <div class="col-sm-12 col-md-10">
                                                            <select name="status" class="custom-select col-12">
                                                                <option>{{this.status}}</option>
                                                                <option value="0">0</option>
                                                                <option value="1">1</option>
                                                                <option value="2">2</option>

                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="form-group row">
                                                        <label class="col-sm-12 col-md-2 col-form-label">Mật
                                                            khẩu</label>
                                                        <div class="col-sm-12 col-md-10">
                                                            <input name="password" value="{{this.password}}"
                                                                class="form-control" type="text" placeholder="">
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Chọn Avatar</label>
                                                        <input type="file" name="avatar"
                                                            class="form-control-file form-control height-auto" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-dismiss="modal">
                                                        Huỷ
                                                    </button>
                                                    <button class="btn btn-primary">
                                                        Cập nhật
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                {{!-- modal update --}}

                                {{/each}}

                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Simple Datatable End -->
            </div>
        </div>

        <div class="pd-ltr-20 xs-pd-20-10">
            <div class="min-height-200px">
                <div class="pd-20 card-box mb-30">
                    <div class="clearfix">
                        <p class="mb-30">Thêm Người Dùng</p>
                    </div>
                    <div class="wizard-content">
                        <form method="post" action="/nguoi-dung" class="tab-wizard wizard-circle wizard">
                            <section>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Tên tài khoản*</label>
                                            <input name="username" type="text" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Họ và tên*</label>
                                            <input name="fullname" type="text" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Điạ chỉ email*</label>
                                            <input name="email" type="email" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Mật khẩu</label>
                                            <input name="password" type="password" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Số điện thoại</label>
                                            <input name="phone" type="tel" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Chọn Avatar*</label>
                                            <input name="avatar" type="file" class="form-control" />
                                        </div>
                                    </div>
                                    <div hidden class="col-md-6">
                                        <div class="form-group">
                                            <input name="status" value="1" type="text" class="form-control" />
                                        </div>
                                    </div>
                                    <div hidden class="col-md-6">
                                        <div class="form-group">
                                            <label>Chọn vai trò*</label>
                                            <input name="role" value="Khách Hàng" type="text" class="form-control" />
                                        </div>
                                    </div>

                                </div>
                                <div class="row">

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Địa chỉ*</label>
                                            <select name="address" class="custom-select form-control">
                                                {{#each xa_kien_giang}}
                                                <option>{{this.path_with_type}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <hr>
                                            <button class="btn btn-success btn-lg btn-block">
                                                Thêm Người Dùng
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </form>
                    </div>
                </div>
            </div>
        </div>

