                            <li><a href="/khach-san/xoa">Xoá</a></li>
                        </ul>
                    </li>
                    <li class="dropdown">
                        <a href="javascript:;" class="dropdown-toggle">
                            <span class="micon">
                                <img  src="/images/core/5.png" alt="" />
                            </span>
                            <span >Điểm Thăm Quan</span>
                        </a>
                        <ul class="submenu">
                            <li><a href="/danh-sach-diem-tham-quan">Danh Sách</a></li>
                            <li><a href="/them-diem-tham-quan">Thêm </a></li>
                            <li><a href="/cap-nhap-diem-tham-quan">Cập Nhật </a></li>
                            <li><a href="/xoa-diem-tham-quan">Xoá</a></li>
                        </ul>
                    </li>
                    <li>
                        <div class="dropdown-divider"></div>
                    </li>
                    <li>
                        <div class=" text-orange">Quản Lý Khác</div>
                    </li>
                    <li>
                        <a href="javascript:;" class="dropdown-toggle">
                            <span class="micon icon-copy fa fa-user-secret"></span><span >Người Dùng</span>
                        </a>
                        <ul class="submenu">
                            <li><a href="/thay-doi-vai-tro">Thay Đổi Vai Trò</a></li>
                            <li><a href="/khoi-phuc-mat-khau">Khôi phục mật khẩu</a></li>
                            <li>
                                <a href="/khoa-tai-khoan">Khoá Tài Khoản</a>
                            </li>
                            <li>
                                <a href="/mo-khoa-tai-khoan">Mở Khoá tài Khoản</a>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a href="javascript:;" class="dropdown-toggle">
                            <span class="micon bi bi-layout-text-window-reverse"></span>
                            <span >
                                Thông Báo
                            </span>
                        </a>
                        <ul class="submenu">
                            <li><a href="/gop-y">Góp ý</a></li>
