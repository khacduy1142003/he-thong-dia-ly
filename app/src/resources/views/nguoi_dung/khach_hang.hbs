                                <img  src="/images/core/3.png" alt="" />
                            </span>
                            <span >Nhà Hàng</span>
                        </a>
                        <ul class="submenu">
                            <li><a href="/nha-hang">Danh Sách</a></li>
                            <li><a href="/thuc-don"> Thực Đơn </a></li>
                            <li><a href="/don-hang"> Đơn Hàng </a></li>
                        </ul>
                    </li>


                    <li class="dropdown">
                        <a href="javascript:;" class="dropdown-toggle">
                            <span class="micon">
                                <img  src="/images/core/4.png" alt="" />
                            </span>
                            <span >Khách Sản</span>
                        </a>
                        <ul class="submenu">
                            <li><a href="/khach-san">Danh Sách</a></li>
                            <li><a href="/khach-san/them">Thêm </a></li>
