                                                        <p>
                                                            Dữ liệu của nhà hàng: <span
                                                                class="text-blue fw-bold">{{this.ten_nha_hang}}</span>
                                                            sẽ bị xoá
                                                            vĩnh viễn và
                                                            không thể khôi phục được nếu bạn tiếp tục xác nhận.
                                                            Cập nhật thông tin nhà hàng!
                                                        </p>
                                                        <form method="POST"
                                                            action="/nha-hang/{{this._id}}?_method=DELETE">
                                                            <button class="btn btn-light">
                                                                <i class="icon-copy ion-checkmark"></i>
                                                            </button>
                                                        </form>
                                                        <button class="btn btn-light" type="button"
                                                            data-dismiss="modal">
                                                            <i class="icon-copy ion-close-round"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {{!-- modal delete --}}
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Export Datatable End -->
                </div>
            </div>
        </div>


        <!-- them nha hang ten ban do -->
        <div class=" modal pd-20 fade bs-example-modal-lg" style="border-radius: 10px;" id="modal-show-add-marker"
            tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
