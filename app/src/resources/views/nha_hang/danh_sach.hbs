                        <div class="pb-20">
                            <table class="table   data-table-export nowrap">
                                <thead>
                                    <tr>
                                        <th class="table-plus datatable-nosort">Image</th>
                                        <th>Nhà Hàng</th>
                                        <th>Email</th>
                                        <th>Điạ chỉ </th>
                                        <th class="datatable-nosort">Tuỳ chọn</th>

                                    </tr>
                                </thead>
                                <tbody>

                                    {{#each nha_hang}}
                                    <tr>
                                        <td class="table-plus">
                                            <img src="/images/nhahang/{{this.anh}}" width="70" height="70" alt="" />
                                        </td>
                                        <td> {{this.ten}} </td>
                                        <td> {{this.email}} </td>
                                        <td> {{this.dia_chi}}</td>
                                        <td>
                                            <div class="dropdown">
                                                <a class="btn btn-link font-24 p-0 line-height-1 no-arrow dropdown-toggle"
                                                    href="#" role="button" data-toggle="dropdown">
                                                    <i class="dw dw-more"></i>
                                                </a>
                                                <div class="dropdown-menu dropdown-menu-right dropdown-menu-icon-list">
                                                    <a class="dropdown-item" href="#"><i class="dw dw-eye"></i> View</a>
                                                    <a class="dropdown-item" href="" data-toggle="modal"
                                                        data-target="#modal-show-update-{{this._id}}" type="button"><i
                                                            class="dw dw-edit2"></i>
                                                        Cập Nhật</a>
                                                    <a class="dropdown-item btn-block" href="#" data-toggle="modal"
                                                        data-target="#delete-modal-{{this._id}}" type="button">
                                                        <i class="dw dw-delete-3"></i>Xoá
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- cap nhật nha hang ten ban do -->
                                        <div class=" modal pd-20 fade bs-example-modal-lg" style="border-radius: 10px;"
                                            id="modal-show-update-{{this._id}}" tabindex="-1" role="dialog"
                                            aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h4 class="modal-title" id="myLargeModalLabel">
                                                            Nhập thông tin để cập nhật nhà hàng.
                                                        </h4>
                                                        <button type="button" class="close" data-dismiss="modal"
                                                            aria-hidden="true">
                                                            <img width="75px" src="images/core/close.png" alt="">
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <form method="POST" action="/nha-hang/{{this._id}}?_method=PUT"
                                                            class="tab-wizard wizard-circle wizard">
                                                            <section>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>Tên nhà hàng*</label>
                                                                            <input name="ten" type="text"
                                                                                class="form-control"
                                                                                value="{{this.ten}}" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>Số điện thoại*</label>
                                                                            <input name="so_dien_thoai" type="text"
                                                                                class="form-control"
                                                                                value="{{this.so_dien_thoai}}" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>vi do*</label>
                                                                            <input name="vi_do" type="text"
                                                                                class="form-control"
                                                                                value="{{this.vi_do}}" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>kinh do*</label>
                                                                            <input name="kinh_do" type="text"
                                                                                class="form-control"
                                                                                value="{{this.kinh_do}}" />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>Chọn Avatar*</label>
                                                                            <input name="anh" type="file"
                                                                                class="form-control" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>Địa chỉ email*</label>
                                                                            <select name="email"
                                                                                class="custom-select form-control">
                                                                                <option>{{this.email}}</option>
                                                                                {{#each ../nguoi_dung_quan_li}}
                                                                                <option>{{this.email}}</option>
                                                                                {{/each}}
                                                                            </select>
                                                                        </div>
                                                                    </div>

                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <label>Địa chỉ*</label>
                                                                            <select name="dia_chi"
                                                                                class="custom-select form-control">
                                                                                <option>{{this.dia_chi}}</option>
                                                                                {{#each ../xa_kien_giang}}
                                                                                <option>{{this.path_with_type}}</option>
                                                                                {{/each}}
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-group">
                                                                            <hr>
                                                                            <button
                                                                                class="btn btn-success btn-lg btn-block">
                                                                                Cập Nhật Nhà Hàng
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </section>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
