    <div class="main-container">
        <div class="xs-pd-10-10 pd-ltr-20">
            <div class="pd-ltr-20 xs-pd-20-10">

                <form action="/mon-an" method="post">
                    <div class="form-group row">
                        <label class="col-sm-12 col-md-2 col-form-label">Tên món ăn*</label>
                        <div class="col-sm-12 col-md-10">
                            <input name="ten" class="form-control" type="text" placeholder="">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-12 col-md-2 col-form-label">Giá*</label>
                        <div class="col-sm-12 col-md-10">
                            <input name="gia" class="form-control" type="text" placeholder="">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-12 col-md-2 col-form-label">Mô tả*</label>
                        <div class="col-sm-12 col-md-10">
                            <textarea name="mo_ta" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-12 col-md-2 col-form-label">Ảnh*</label>
                        <div class="col-sm-12 col-md-10">
                            <input name="anh" class="form-control" type="file" placeholder="">

                        </div>
                    </div>
                    <button class="btn btn-outline-primary btn-lg btn-block"> Thêm Món Ăn </button>
                </form>

            </div>
            <div class="pd-ltr-20 xs-pd-20-10">

                <div class="min-height-200px">
                    <!-- Simple Datatable start -->
                    <div class="card-box mb-30">
                        <div class="pb-20">
                            <table class="table   data-table-export nowrap">
                                <thead>
                                    <tr>
                                        <th class="table-plus datatable-nosort">Image</th>
                                        <th> Tên </th>
                                        <th> Giá </th>
                                        <th> Mô tả </th>
                                        <th class="datatable-nosort">Tuỳ chọn</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each mon_an}}
                                    <tr>
                                        <td class="table-plus">
                                            <img src="images/monan/{{this.anh}}" width="70" height="70" alt="" />
                                        </td>
                                        <td> {{this.ten}} </td>
                                        <td> {{this.gia}} </td>
                                        <td> {{this.mo_ta}}</td>
                                        <td>
                                            <div class="dropdown">
                                                <a class="btn btn-link font-24 p-0 line-height-1 no-arrow dropdown-toggle"
                                                    href="#" role="button" data-toggle="dropdown">
                                                    <i class="dw dw-more"></i>
                                                </a>
                                                <div class="dropdown-menu dropdown-menu-right dropdown-menu-icon-list">
                                                    <a class="dropdown-item" href="#"><i class="dw dw-eye"></i> View</a>
                                                    <a class="dropdown-item" href="" data-toggle="modal"
                                                        data-target="#modal-show-update-{{this._id}}" type="button"><i
                                                            class="dw dw-edit2"></i>
                                                        Cập Nhật</a>
                                                    <a class="dropdown-item btn-block" href="#" data-toggle="modal"
                                                        data-target="#delete-modal-{{this._id}}" type="button">
                                                        <i class="dw dw-delete-3"></i>Xoá
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- cap nhật nha hang ten ban do -->
                                        <div class=" modal pd-20 fade bs-example-modal-lg" style="border-radius: 10px;"
                                            id="modal-show-update-{{this._id}}" tabindex="-1" role="dialog"
                                            aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h4 class="modal-title" id="myLargeModalLabel">
                                                            Nhập thông tin để cập nhật <span
                                                                class="text-blue fw-bold">{{this.ten}}</span>
                                                        </h4>
                                                        <button type="button" class="close" data-dismiss="modal"
                                                            aria-hidden="true">
                                                            ×
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <form method="POST" action="/mon-an/{{this._id}}?_method=PUT"
                                                            class="tab-wizard wizard-circle wizard">
                                                            <div class="form-group row">
                                                                <label class="col-sm-12 col-md-2 col-form-label">Tên món
                                                                    ăn*</label>
                                                                <div class="col-sm-12 col-md-10">
                                                                    <input value="{{this.ten}}" name="ten"
                                                                        class="form-control" type="text" placeholder="">
                                                                </div>
                                                            </div>

                                                            <div class="form-group row">
                                                                <label
                                                                    class="col-sm-12 col-md-2 col-form-label">Giá*</label>
                                                                <div class="col-sm-12 col-md-10">
                                                                    <input name="gia" value="{{this.gia}}"
                                                                        class="form-control" type="text" placeholder="">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row">
                                                                <label class="col-sm-12 col-md-2 col-form-label">Mô
                                                                    tả*</label>
                                                                <div class="col-sm-12 col-md-10">
                                                                    <textarea name="mo_ta"
                                                                        class="form-control"> {{this.mo_ta}}</textarea>
                                                                </div>
                                                            </div>
                                                            <div class="form-group row">
                                                                <label
                                                                    class="col-sm-12 col-md-2 col-form-label">Ảnh*</label>
                                                                <div class="col-sm-12 col-md-10">
                                                                    <input name="anh" class="form-control" type="file"
                                                                        placeholder="">

                                                                </div>
                                                            </div>
                                                            <button class="btn btn-outline-primary btn-lg btn-block">
                                                                Cập Nhật </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- cap nhật nha hang ten ban do -->
                                        {{!-- modal delete --}}
                                        <div class="modal fade" id="delete-modal-{{this._id}}" tabindex="-1"
                                            role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-sm modal-dialog-centered">
                                                <div class="modal-content bg-danger text-white">
                                                    <div class="modal-body text-center">
                                                        <h3 class="text-white mb-15">
                                                            <i class="fa fa-exclamation-triangle"></i> Cảnh Báo
                                                        </h3>
                                                        <p>
                                                            Dữ liệu của món ăn: <span
                                                                class="text-blue fw-bold">{{this.ten}}</span>
                                                            sẽ bị xoá
                                                            vĩnh viễn và
                                                            không thể khôi phục được nếu bạn tiếp tục xác nhận.
                                                            Cập nhật thông tin nhà hàng!
                                                        </p>
                                                        <form method="POST"
                                                            action="/mon-an/{{this._id}}?_method=DELETE">
                                                            <button class="btn btn-light">
                                                                <i class="icon-copy ion-checkmark"></i>
                                                            </button>
                                                        </form>
                                                        <button class="btn btn-light" type="button"
                                                            data-dismiss="modal">
                                                            <i class="icon-copy ion-close-round"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {{!-- modal delete --}}
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Export Datatable End -->
                </div>
            </div>
        </div>
