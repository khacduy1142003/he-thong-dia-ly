
        <!-- them nha hang ten ban do -->
        <div class=" modal pd-20 fade bs-example-modal-lg" style="border-radius: 10px;" id="modal-show-add-marker"
            tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="myLargeModalLabel">
                            Nhập thông tin để thêm nhà hàng mới.
                        </h4>
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                            ×
                        </button>
                    </div>
                    <div class="modal-body">
                        <form method="post" action="/nha-hang" class="tab-wizard wizard-circle wizard">
                            <section>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Tên nhà hàng*</label>
                                            <input name="ten_nha_hang" type="text" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>vi do*</label>
                                                    <input id="vido-view" name="vido" type="text"
                                                        class="form-control" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>kinh do*</label>
                                                    <input id="kinhdo-view" name="kinhdo" type="text"
                                                        class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Chọn Avatar*</label>
                                            <input name="avatar" type="file" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Địa chỉ email*</label>
                                            <select name="email" class="custom-select form-control">
                                                {{#each nguoi_dung_quan_li}}
                                                <option>{{this.email}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Địa chỉ*</label>
                                            <select name="address" class="custom-select form-control">
                                                {{#each xa_kien_giang}}
                                                <option>{{this.path_with_type}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <hr>
                                            <button class="btn btn-success btn-lg btn-block">
                                                Thêm Nhà Hàng
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- them nha hang ten ban do -->
